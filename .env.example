# Copy to .env (never commit it: the repo is public). Variables from docs/SPEC.md §11.1.
# Local runs: SPRING_PROFILES_ACTIVE=fake needs no provider keys.
SPRING_PROFILES_ACTIVE=fake

PUBLIC_UI_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
CITIES=mde:Medellín,bog:Bogotá
# One admin token per city, at least 24 characters each, all different
ADMIN_TOKEN_MDE=
ADMIN_TOKEN_BOG=
DATA_DIR=./data

# Image generation (D-011, D-012); only the fake provider exists in phase A1
IMAGE_PROVIDER_CHAIN=fal,bfl
IMAGE_LOAD_SPLIT=fal,bfl
FAL_KEY=
FAL_MODEL=fal-ai/flux-2/klein/9b
FAL_MAX_CONCURRENCY=10
BFL_API_KEY=
BFL_MODEL=flux-2-klein-9b
BFL_MAX_CONCURRENCY=24
IMAGE_TIMEOUT_SECONDS=45

# Embeddings (D-013)
GEMINI_API_KEY=
EMBEDDING_PROVIDER_CHAIN=gemini,cohere
EMBEDDING_MODE=entries
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_RPM=90
GEMINI_EMBEDDING_TPM=27000
GEMINI_EMBEDDING_RPD=1000
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-v4.0

# Commentary
ANTHROPIC_API_KEY=
COMMENTARY_MODEL=claude-sonnet-5-5

# Game tuning
ATTEMPTS_PER_ROUND=3
ROUND_GRACE_SECONDS=20
CALIBRATION_ANCHORS=6
MINI_PODIUM_ENABLED=true
PROMPT_TRANSLATE_TO_EN=false
PROMPT_LLM_MODERATION=false

# Fake provider (profile "fake"): latency, random failure rate, concurrency limit
FAKE_LATENCY_MS=1500
FAKE_FAILURE_RATE=0
FAKE_MAX_CONCURRENCY=10

# Behind a proxy (Railway) the client IP comes from X-Forwarded-For: framework | native | none
FORWARD_HEADERS_STRATEGY=framework
